# Server-side environment variables for AirWise AI.
# Copy this file to .env.local and replace the placeholder values with your real keys.
# Never prefix these secrets with NEXT_PUBLIC_ and never commit .env.local.

# OpenWeather API key (Air Pollution, Forecast, Weather, and Geocoding)
# Obtain from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API key (used server-side by POST /api/ai/recommendations)
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini Flash model (defaults to gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional (India Ground Stations): Official data.gov.in API key for CPCB Real-Time AQI
# Resource: 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69 (GODL-India).
# Never prefix with NEXT_PUBLIC_. If unset, Indian locations fall back to Open-Meteo US AQI.
# Obtain a free key from: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Public browser-side CARTO Basemaps API key for Dark Matter raster tiles on /global-map.
# Note: Because Leaflet loads map tiles directly in the browser, NEXT_PUBLIC_ is intentional.
# Restrict this key by allowed domain/HTTP referer in CARTO's dashboard for public deployments.
# Obtain a free key from: https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_BASEMAP_KEY=your_carto_basemap_key_here
